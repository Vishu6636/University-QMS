# UQMS Environment Variables Template
# Copy this file to .env and fill in your configuration values.

# Groq API Key (Required for RAG Chat answers & Admin Assistant)
GROQ_API_KEY=your_groq_api_key_here

# Brevo (Sendinblue) Email Credentials (Required for OTP verification & Platform Complaints)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
PLATFORM_OWNER_EMAIL=admin@yourdomain.com

# Database Connection URL (Optional, defaults to local SQLite)
# SQLite: sqlite:///./data/university_qms.db
# PostgreSQL: postgresql://user:password@localhost:5432/uqms_db
DATABASE_URL=sqlite:///./data/university_qms.db

# ChromaDB Vector Store Path (Optional, defaults to ./data/chroma)
CHROMA_PATH=./data/chroma

# Session Timeout in Minutes (Optional, default: 30)
SESSION_TIMEOUT_MINUTES=30

# Sentry DSN Error Tracking (Optional)
SENTRY_DSN=
SENTRY_ENV=production
